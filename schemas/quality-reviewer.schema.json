{
  "title": "quality-reviewer report",
  "type": "object",
  "required": [
    "role",
    "quality_gates",
    "issues"
  ],
  "properties": {
    "role": {
      "const": "quality-reviewer"
    },
    "quality_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check",
          "status"
        ],
        "properties": {
          "check": {
            "enum": [
              "Test",
              "Lint",
              "Format",
              "Type check"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIP"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "location",
          "description",
          "fix"
        ],
        "properties": {
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "location": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
