{
  "title": "spec-reviewer report",
  "type": "object",
  "required": [
    "role",
    "acceptance_criteria",
    "issues"
  ],
  "properties": {
    "role": {
      "const": "spec-reviewer"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]+$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "WARN"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "architecture": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "constitution": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "principle",
          "status"
        ],
        "properties": {
          "principle": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "N/A"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "spec_compliance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check",
          "status"
        ],
        "properties": {
          "check": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "WARN",
              "N/A"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "description",
          "fix"
        ],
        "properties": {
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "ac": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
